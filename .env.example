# CodeBounty Environment Variables Template
# Copy this file to .env and fill in the values

# ===== SOROBAN NETWORK =====
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_SOURCE_ACCOUNT=
SOROBAN_SOURCE_SECRET=

# ===== CONTRACT ADDRESSES =====
BOUNTY_REGISTRY_ADDRESS=
MERGE_VERIFIER_ADDRESS=

# ===== FRONTEND =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SECRET=
NEXT_PUBLIC_BOUNTY_REGISTRY_ADDRESS=
NEXT_PUBLIC_MERGE_VERIFIER_ADDRESS=
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ===== RELAY SERVICE =====
DATABASE_URL=postgresql://codebounty:change-me@localhost:5432/codebounty?schema=public
AI_REVIEW_API_KEY=
AI_REVIEW_MODEL=
GITHUB_WEBHOOK_SECRET=
RELAY_PRIVATE_KEY=
PORT=3000
