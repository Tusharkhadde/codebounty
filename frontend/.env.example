# CodeBounty Frontend Environment Variables
# Copy this file to .env.local and fill in the values
NEXT_PUBLIC_APP_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SECRET=
# Required in production: generate with a cryptographically secure password generator.
# Optional only when a real shared storage endpoint is configured.
CLOUDBOUNTY_STORAGE_URL=

NEXT_PUBLIC_BOUNTY_REGISTRY_ADDRESS=
NEXT_PUBLIC_MERGE_VERIFIER_ADDRESS=
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RELAY_URL=http://localhost:3000
RELAY_URL=http://localhost:3001
NEXT_PUBLIC_RELAY_WS_URL=ws://localhost:3001/ws
