datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Bounty {
  id          Int      @id
  issueUrl    String   @map("issue_url")
  creator     String
  ownerGithubLogin String? @map("owner_github_login")
  ownerWalletAddress String? @map("owner_wallet_address")
  amount      Float
  token       String?  @default("XLM")
  deadline    BigInt
  status      String   @default("funded")
  linkedPrUrl String?  @map("linked_pr_url")
  contributor String?
  fundedAt    BigInt   @map("funded_at")
  paidAt      BigInt   @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("bounties")
}

model AuditLog {
  id          String   @id @default(cuid())
  bountyId    Int      @map("bounty_id")
  githubLogin String   @map("github_login")
  walletAddress String? @map("wallet_address")
  action      String
  previousState String? @map("previous_state")
  newState    String? @map("new_state")
  transactionHash String? @map("transaction_hash")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([bountyId])
  @@map("audit_logs")
}
