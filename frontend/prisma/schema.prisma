datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Bounty {
  id          Int      @id
  issueUrl    String   @map("issue_url")
  creator     String
  amount      Float
  token       String?  @default("XLM")
  deadline    BigInt
  status      String   @default("funded")
  linkedPrUrl String?  @map("linked_pr_url")
  contributor String?
  fundedAt    BigInt   @map("funded_at")
  paidAt      BigInt   @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("bounties")
}
