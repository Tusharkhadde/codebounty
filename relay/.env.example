# CodeBounty Relay Service Environment Variables
# Copy this file to .env and fill in the values

GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
DATABASE_URL=postgresql://codebounty:change-me@localhost:5432/codebounty?schema=public
AI_REVIEW_API_KEY=
AI_REVIEW_MODEL=
RELAY_PRIVATE_KEY=your-ed25519-private-key-hex
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
MERGE_VERIFIER_ADDRESS=
BOUNTY_REGISTRY_ADDRESS=
PORT=3000
